@model RealEstateApp.Core.Application.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Iniciar Sesión"; }

<div class="app-auth-wrapper">
    <div class="app-auth-card">
        <div class="app-auth-icon">
            <i class="bi bi-house-door-fill"></i>
        </div>
        <h2 class="app-auth-title">Iniciar Sesión</h2>
        <p class="app-auth-subtitle">Bienvenido de nuevo a RealEstateApp</p>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="UserNameOrEmail" class="form-label">Correo o nombre de usuario</label>
                <input asp-for="UserNameOrEmail" class="form-control app-form-control" />
                <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label">Contraseña</label>
                <input asp-for="Password" class="form-control app-form-control" type="password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn app-primary-button w-100">
                <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar sesión
            </button>
        </form>

        <div class="app-auth-footer">
            ¿No tienes cuenta? <a asp-action="Register">Únete a la app</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}