@{
    ViewData["Title"] = "Acceso denegado";

    var (controllerName, linkText) =
        User.IsInRole("Cliente") ? ("ClientHome", "Ir a mi Home")
        : User.IsInRole("Agente") ? ("AgentHome", "Ir a mi Home")
        : User.IsInRole("Administrador") ? ("AdminHome", "Ir a mi Home")
        : ("Home", "Ir al inicio");
}

<div class="d-flex justify-content-center align-items-center app-access-denied-wrapper">
    <div class="card app-access-denied-card border-0 shadow-sm text-center">
        <div class="card-body p-5">
            <div class="app-access-denied-icon mb-4">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h2 class="app-access-denied-title mb-3">Acceso denegado</h2>
            <p class="text-muted mb-4">
                No tiene permisos para acceder a esta sección. Su usuario no cuenta con el rol necesario para ver esta funcionalidad.
            </p>
            <a asp-controller="@controllerName" asp-action="Index" class="btn app-access-denied-button">
                <i class="bi bi-house-door-fill me-2"></i>@linkText
            </a>
        </div>
    </div>
</div>