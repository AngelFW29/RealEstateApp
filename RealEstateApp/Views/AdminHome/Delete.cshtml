@model RealEstateApp.Core.Application.ViewModels.Admin.ConfirmAgentActionViewModel
@{
    ViewData["Title"] = "Eliminar Agente";
}

<div class="container mt-4">
    <h2>Eliminar Agente</h2>
    <hr />

    <div class="alert alert-danger" role="alert">
        ¿Está seguro que desea eliminar este agente y todas sus propiedades? Esta acción no se puede deshacer.
    </div>

    <div class="card mb-3" style="max-width: 500px;">
        <div class="card-body">
            <h5 class="card-title">@Model.FullName</h5>
            <p class="card-text text-muted">@Model.Email</p>
        </div>
    </div>

    <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-danger">Aceptar</button>
    </form>
</div>