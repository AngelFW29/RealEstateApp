@model RealEstateApp.Core.Application.ViewModels.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard del Administrador";
}

<div class="container-fluid px-4 py-3">
    <h2 class="mb-4">Panel de Control del Administrador</h2>

    <div class="row g-4">
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary fw-bold">Propiedades</h5>
                    <hr />
                    <p class="mb-2"><strong>Disponibles:</strong> <span class="badge bg-success fs-6">@Model.AvailableProperties</span></p>
                    <p class="mb-0"><strong>Vendidas:</strong> <span class="badge bg-secondary fs-6">@Model.SoldProperties</span></p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title text-success fw-bold">Agentes</h5>
                    <hr />
                    <p class="mb-2"><strong>Activos:</strong> <span class="badge bg-success fs-6">@Model.ActiveAgents</span></p>
                    <p class="mb-0"><strong>Inactivos:</strong> <span class="badge bg-danger fs-6">@Model.InactiveAgents</span></p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title text-info fw-bold">Clientes</h5>
                    <hr />
                    <p class="mb-2"><strong>Activos:</strong> <span class="badge bg-success fs-6">@Model.ActiveClients</span></p>
                    <p class="mb-0"><strong>Inactivos:</strong> <span class="badge bg-danger fs-6">@Model.InactiveClients</span></p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title text-warning fw-bold">Desarrolladores</h5>
                    <hr />
                    <p class="mb-2"><strong>Activos:</strong> <span class="badge bg-success fs-6">@Model.ActiveDevelopers</span></p>
                    <p class="mb-0"><strong>Inactivos:</strong> <span class="badge bg-danger fs-6">@Model.InactiveDevelopers</span></p>
                </div>
            </div>
        </div>
    </div>
</div>