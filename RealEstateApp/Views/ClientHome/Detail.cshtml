
@model ClientPropertyDetailViewModel
@{
    ViewData["Title"] = $"Propiedad {Model.Property.Code}";
}

<div class="client-detail-page">
    <a asp-controller="ClientHome" asp-action="Index" class="btn btn-outline-secondary agent-back-button mb-4">
        <i class="bi bi-arrow-left"></i>
        Volver
    </a>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success app-alert">
            @successMessage
            <button type="button" class="btn-close float-end" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger app-alert">
            @errorMessage
            <button type="button" class="btn-close float-end" data-bs-dismiss="alert"></button>
        </div>
    }

    <partial name="~/Views/Shared/Components/_PropertyDetailContent.cshtml" model="Model.Property" />

    <hr class="client-detail-divider" />

    <div class="row g-4 client-detail-sections">
        <div class="col-lg-6">
            <section class="client-detail-card">
                <div class="client-detail-card-header">
                    <i class="bi bi-chat-dots"></i>
                    <h5>Conversación con el agente</h5>
                </div>

                <div class="client-conversation-messages">
                    @if (Model.Messages.Count == 0)
                    {
                        <p class="text-muted mb-0">Aún no hay mensajes en esta conversación.</p>
                    }

                    @foreach (var message in Model.Messages)
                    {
                        <div class="d-flex @(message.IsFromClient ? "justify-content-end" : "justify-content-start") mb-3">
                            <div class="client-message-bubble @(message.IsFromClient ? "client-message-sent" : "client-message-received")">
                                <div class="small fw-bold">@message.SenderText</div>
                                <div class="client-message-content">@message.Content</div>
                                <div class="small opacity-75">@message.SentAt.ToLocalDisplay()</div>
                            </div>
                        </div>
                    }
                </div>

                <form method="post" asp-controller="ClientHome" asp-action="SendMessage" novalidate class="client-message-form">
                    <input type="hidden" name="PropertyId" value="@Model.NewMessage.PropertyId" />

                    <div class="mb-3">
                        <label for="messageContent" class="form-label">Mensaje</label>
                        <textarea id="messageContent" name="Content" class="form-control app-form-control" rows="3" maxlength="1000"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary app-primary-button">
                        <i class="bi bi-send"></i>
                        Enviar mensaje
                    </button>
                </form>
            </section>
        </div>

        <div class="col-lg-6">
            <section class="client-detail-card">
                <div class="client-detail-card-header client-offers-header">
                    <div>
                        <i class="bi bi-receipt"></i>
                        <h5>Mis ofertas</h5>
                    </div>

                    @if (Model.CanSendOffer)
                    {
                        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#offerModal">
                            <i class="bi bi-plus-lg"></i>
                            Nueva oferta
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-success" disabled>
                            <i class="bi bi-plus-lg"></i>
                            Nueva oferta
                        </button>
                    }
                </div>

                @if (!Model.CanSendOffer)
                {
                    <div class="alert alert-warning app-alert">@Model.OfferBlockReason</div>
                }

                @if (Model.Offers.Count == 0)
                {
                    <p class="text-muted client-empty-offers">No ha realizado ofertas para esta propiedad.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle client-offers-table">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Monto ofertado</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var offer in Model.Offers)
                                {
                                    <tr>
                                        <td>@offer.CreatedAt.ToLocalDisplay()</td>
                                        <td>RD$ @offer.Amount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                        <td><span class="badge @offer.Status.ToBadgeClass()">@offer.StatusText</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    </div>
</div>

<div class="modal fade" id="offerModal" tabindex="-1" aria-labelledby="offerModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content client-offer-modal">
            <form method="post" asp-controller="ClientHome" asp-action="SendOffer" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="offerModalLabel">Enviar nueva oferta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="PropertyId" value="@Model.NewOffer.PropertyId" />
                    <label for="offerAmount" class="form-label">Monto ofertado (RD$)</label>
                    <input id="offerAmount" name="Amount" type="number" step="0.01" class="form-control app-form-control" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary app-secondary-button" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Enviar oferta</button>
                </div>
            </form>
        </div>
    </div>
</div>
