@model RealEstateApp.Core.Application.ViewModels.Property.SavePropertyViewModel
@{
    ViewData["Title"] = "Editar Propiedad";
}

<div class="property-detail-extra">
    <div class="row g-4">
        <div class="col-lg-9 mx-auto">
            <div class="property-detail-section">
                <h5>
                    <i class="bi bi-pencil-square"></i>
                    Editar Propiedad
                </h5>

                <form asp-action="Edit" method="post" enctype="multipart/form-data" id="propertyForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <partial name="_PropertyForm" model="Model" />
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn app-secondary-button">
                            <i class="bi bi-arrow-left me-1"></i>Volver atrás
                        </a>
                        <button type="submit" class="btn app-primary-button" id="submitBtn">
                            <i class="bi bi-check-lg me-1"></i>Guardar propiedad
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/property-images.js"></script>
}