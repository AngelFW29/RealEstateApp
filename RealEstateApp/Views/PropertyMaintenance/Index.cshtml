@model List<RealEstateApp.Core.Application.ViewModels.Property.PropertyListViewModel>
@{
    ViewData["Title"] = "Mantenimiento de Propiedades";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Mantenimiento de Propiedades Disponibles</h2>
        <a asp-action="Create" class="btn btn-success"> Crear propiedad</a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <h4 class="alert-heading">Sin propiedades</h4>
            <p class="mb-0">No tiene propiedades disponibles registradas en este momento.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var property in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="@property.MainImageUrl" class="card-img-top" alt="Imagen de propiedad" style="height: 200px; object-fit: cover;" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-dark fw-bold">Cód: @property.Code</h5>
                            <h4 class="text-success fw-bold mb-3">@property.Price.ToString("C", new System.Globalization.CultureInfo("es-DO"))</h4>
                            <div class="mt-auto d-flex justify-content-between">
                                <a asp-action="Edit" asp-route-id="@property.Id" class="btn btn-warning btn-sm w-50 me-1">Editar</a>
                                <a asp-action="Delete" asp-route-id="@property.Id" class="btn btn-danger btn-sm w-50 ms-1">Eliminar</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>