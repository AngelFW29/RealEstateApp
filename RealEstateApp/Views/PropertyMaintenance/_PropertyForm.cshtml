@model RealEstateApp.Core.Application.ViewModels.Property.SavePropertyViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

@if (Model.Id != 0)
{
    <div class="mb-3">
        <label asp-for="Code" class="form-label">Código de Propiedad</label>
        <input asp-for="Code" class="form-control app-form-control" readonly />
    </div>
}

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="PropertyTypeId" class="form-label">Tipo de Propiedad</label>
        <select asp-for="PropertyTypeId" class="form-select app-form-control"
                asp-items="@(new SelectList(Model.PropertyTypes, "Id", "Name"))">
            <option value="">-- Seleccione un tipo --</option>
        </select>
        <span asp-validation-for="PropertyTypeId" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="SaleTypeId" class="form-label">Tipo de Venta</label>
        <select asp-for="SaleTypeId" class="form-select app-form-control"
                asp-items="@(new SelectList(Model.SaleTypes, "Id", "Name"))">
            <option value="">-- Seleccione tipo de venta --</option>
        </select>
        <span asp-validation-for="SaleTypeId" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Price" class="form-label">Precio (RD$)</label>
        <input asp-for="Price" class="form-control app-form-control" type="number" step="0.01" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Size" class="form-label">Tamaño (m²)</label>
        <input asp-for="Size" class="form-control app-form-control" type="number" step="0.01" />
        <span asp-validation-for="Size" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Bedrooms" class="form-label">Habitaciones</label>
        <input asp-for="Bedrooms" class="form-control app-form-control" type="number" min="0" />
        <span asp-validation-for="Bedrooms" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Bathrooms" class="form-label">Baños</label>
        <input asp-for="Bathrooms" class="form-control app-form-control" type="number" min="0" />
        <span asp-validation-for="Bathrooms" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label">Descripción</label>
    <textarea asp-for="Description" class="form-control app-form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="mb-3">
    <label class="form-label">Mejoras</label>
    <div class="row">
        @foreach (var improvement in Model.Improvements)
        {
            <div class="col-md-4">
                <div class="form-check">
                    <input type="checkbox" name="ImprovementIds" value="@improvement.Id"
                           class="form-check-input" id="imp_@improvement.Id"
                    @(Model.ImprovementIds != null && Model.ImprovementIds.Contains(improvement.Id) ? "checked" : "") />
                    <label class="form-check-label" for="imp_@improvement.Id">@improvement.Name</label>
                </div>
            </div>
        }
    </div>
    <span asp-validation-for="ImprovementIds" class="text-danger"></span>
</div>

@if (Model.Id != 0 && Model.CurrentImages != null && Model.CurrentImages.Any())
{
    <div class="mb-3">
        <label class="form-label">Imágenes Actuales (Marque las que desea eliminar)</label>
        <div class="row g-2">
            @foreach (var img in Model.CurrentImages)
            {
                <div class="col-md-3 text-center">
                    <img src="@img.Url" class="img-thumbnail mb-1"
                         style="height: 100px; object-fit: cover; width: 100%;" />
                    <div class="form-check">
                        <input type="checkbox" name="ImageIdsToRemove" value="@img.Id"
                               class="form-check-input" id="img_@img.Id" />
                        <label class="form-check-label small" for="img_@img.Id">Eliminar</label>
                    </div>
                </div>
            }
        </div>
    </div>
}

<div class="mb-3">
    <label class="form-label">Imágenes (Máximo 4 en total)</label>
    <input type="file" id="propertyImagesInput"
           name="@(Model.Id == 0 ? "images" : "newImages")"
           class="form-control app-form-control" multiple accept=".jpg,.jpeg,.png" />
    <div class="form-text" id="imageCountInfo">Seleccione archivos válidos (.jpg, .jpeg, .png).</div>
</div>