@model RealEstateApp.Core.Application.ViewModels.Property.PropertyListViewModel
@{
    ViewData["Title"] = "Eliminar Propiedad";
}

<div class="property-detail-extra">
    <div class="row g-4">
        <div class="col-lg-7 mx-auto">
            <div class="property-detail-section text-center">
                <h5 class="justify-content-center">
                    <i class="bi bi-exclamation-triangle"></i>
                    Eliminar Propiedad
                </h5>

                <p class="lead text-muted mt-3">¿Está seguro que desea eliminar esta propiedad?</p>

                <div class="my-4">
                    <img src="@Model.MainImageUrl" class="img-thumbnail"
                         style="max-height: 180px; object-fit: cover;" alt="Propiedad @Model.Code" />
                    <h5 class="mt-3 mb-1">Código: @Model.Code</h5>
                    <p class="text-muted mb-0">@Model.PropertyTypeName · @Model.SaleTypeName</p>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <a asp-action="Index" class="btn app-secondary-button">
                            <i class="bi bi-x-lg me-1"></i>Cancelar
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Aceptar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>