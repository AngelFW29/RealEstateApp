@model RealEstateApp.Core.Application.ViewModels.Property.PropertyListViewModel
@{
    ViewData["Title"] = "Eliminar Propiedad";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 p-4 text-center">
                <h3 class="text-danger mb-3">Eliminar Propiedad</h3>
                <p class="lead">¿Está seguro que desea eliminar esta propiedad?</p>
                <div class="my-3">
                    <img src="@Model.MainImageUrl" class="img-thumbnail" style="max-height: 150px; object-fit: cover;" />
                    <h5 class="mt-2">Código: @Model.Code</h5>
                    <p class="text-muted">@Model.PropertyTypeName - @Model.SaleTypeName</p>
                </div>
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-danger">Aceptar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>