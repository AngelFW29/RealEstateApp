@model AgentPropertiesViewModel
@{
    ViewData["Title"] = $"Propiedades de {Model.Agent.FullName}";

    var filterViewData = new ViewDataDictionary(ViewData)
    {
        { "FilterController", "Agents" },
        { "FilterAction", "Properties" },
        { "FilterRouteId", Model.Agent.Id }
    };
}

<a asp-controller="Agents" asp-action="Index" class="btn btn-outline-secondary mb-3">Volver a agentes</a>

<div class="d-flex align-items-center gap-3 mb-4">
    @if (string.IsNullOrEmpty(Model.Agent.PhotoPath))
    {
        <div class="bg-secondary rounded-circle" style="width: 72px; height: 72px;"></div>
    }
    else
    {
        <img src="@Model.Agent.PhotoPath" class="rounded-circle" alt="Foto de @Model.Agent.FullName" style="width: 72px; height: 72px; object-fit: cover;" />
    }

    <h2 class="mb-0">@Model.Agent.FullName</h2>
</div>

<partial name="~/Views/Shared/Components/_PropertyFilters.cshtml" model="Model.Filter" view-data="filterViewData" />

@if (!string.IsNullOrEmpty(Model.EmptyMessage))
{
    <div class="alert alert-info">@Model.EmptyMessage</div>
}

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var property in Model.Properties)
    {
        <div class="col">
            <partial name="~/Views/Shared/Components/_PropertyCard.cshtml" model="property" />
        </div>
    }
</div>