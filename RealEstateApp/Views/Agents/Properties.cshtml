@model AgentPropertiesViewModel
@{
    ViewData["Title"] = $"Propiedades de {Model.Agent.FullName}";

    var filterViewData = new ViewDataDictionary(ViewData)
    {
        { "FilterController", "Agents" },
        { "FilterAction", "Properties" },
        { "FilterRouteId", Model.Agent.Id }
    };
}

<div class="agent-properties-page">
	<a asp-controller="Agents" asp-action="Index" class="btn btn-outline-secondary agent-back-button mb-4">
		<i class="bi bi-arrow-left"></i> Volver a agentes
	</a>

	<div class="agent-profile-header">
		@if (string.IsNullOrEmpty(Model.Agent.PhotoPath))
		{
			<div class="agent-profile-photo-placeholder">
				<i class="bi bi-person"></i>
			</div>
		}
		else
		{
			<img src="@Model.Agent.PhotoPath" class="agent-profile-photo" alt="Foto de @Model.Agent.FullName" />
		}

		<div>
			<span class="section-eyebrow">AGENTE INMOBILIARIO</span>
			<h2 class="agent-profile-name">@Model.Agent.FullName</h2>
			<p class="agent-profile-description">Propiedades disponibles de este agente.</p>
		</div>
	</div>

	<partial name="~/Views/Shared/Components/_PropertyFilters.cshtml" model="Model.Filter" view-data="filterViewData" />

	@if (!string.IsNullOrEmpty(Model.EmptyMessage))
	{
		<div class="alert alert-info app-alert">@Model.EmptyMessage</div>
	}

	<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 property-grid">
		@foreach (var property in Model.Properties)
		{
			<div class="col">
				<partial name="~/Views/Shared/Components/_PropertyCard.cshtml" model="property" />
			</div>
		}
	</div>
</div>