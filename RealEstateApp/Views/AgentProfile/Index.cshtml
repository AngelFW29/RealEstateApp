@model RealEstateApp.Core.Application.ViewModels.Agent.AgentProfileViewModel
@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Mi Perfil de Agente</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Index" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="text-center mb-4">
                            @if (!string.IsNullOrEmpty(Model.CurrentPhotoUrl))
                            {
                                <img id="previewImage" src="@Model.CurrentPhotoUrl" alt="Foto de Perfil" class="rounded-circle img-thumbnail" style="width: 120px; height: 120px; object-fit: cover;" />
                            }
                            else
                            {
                                <img id="previewImage" src="/images/default-user.png" alt="Foto por defecto" class="rounded-circle img-thumbnail" style="width: 120px; height: 120px; object-fit: cover;" />
                            }
                        </div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-bold">Nombre</label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-bold">Teléfono</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label for="profileImage" class="form-label fw-bold">Nueva Fotografía (Opcional)</label>
                            <input type="file" id="profileImage" name="profileImage" class="form-control" accept=".jpg,.jpeg,.png" onchange="previewFile(this);" />
                            <div class="form-text">Formatos permitidos: .jpg, .jpeg, .png (Máx. 5 MB).</div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-controller="AgentHome" asp-action="Index" class="btn btn-secondary">Volver atrás</a>
                            <button type="submit" class="btn btn-primary">Guardar cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewFile(input) {
            const file = input.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('previewImage').src = e.target.result;
                }
                reader.readAsDataURL(file);
            }
        }
    </script>
}