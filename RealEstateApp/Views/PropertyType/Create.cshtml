@model RealEstateApp.Core.Application.ViewModels.Catalog.SaveCatalogViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Crear Tipo de Propiedad" : "Editar Tipo de Propiedad";
}
<div class="property-detail-extra">
    <div class="row g-4">
        <div class="col-lg-8 mx-auto">
            <div class="property-detail-section">
                <h5><i class="bi bi-house-door"></i>@ViewData["Title"]</h5>

                <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Nombre</label>
                        <input asp-for="Name" class="form-control app-form-control" placeholder="Escriba el nombre..." />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Descripción</label>
                        <textarea asp-for="Description" class="form-control app-form-control" rows="3" placeholder="Escriba una descripción..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn app-secondary-button">
                            <i class="bi bi-arrow-left me-1"></i>Volver atrás
                        </a>

                        <button type="submit" class="btn app-primary-button">
                            <i class="bi bi-check-lg me-1"></i>Guardar cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}