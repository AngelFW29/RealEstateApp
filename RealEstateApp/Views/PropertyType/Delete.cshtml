@model RealEstateApp.Core.Application.ViewModels.Catalog.SaveCatalogViewModel
@{
    ViewData["Title"] = "Eliminar Registro";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 p-4">
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading fw-bold">¿Está seguro que desea eliminar este tipo de propiedad y todas las propiedades asociadas?</h4>
                    <p class="mb-0">Esta acción no se puede deshacer. Las propiedades asociadas a este elemento, también serán eliminadas.</p>
                </div>

                <div class="mb-3">
                    <label class="text-muted small">Nombre</label>
                    <p class="fs-5 fw-bold mb-0">@Model.Name</p>
                </div>

                <div class="mb-3">
                    <label class="text-muted small">Descripción</label>
                    <p class="mb-0">@Model.Description</p>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn app-secondary-button">
                            <i class="bi bi-x-lg me-1"></i>Cancelar
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Sí, eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>