@model RealEstateApp.Core.Application.ViewModels.Catalog.CatalogListViewModel
@{ ViewData["Title"] = "Eliminar Registro"; }

<div class="property-detail-extra">
    <div class="row g-4">
        <div class="col-lg-7 mx-auto">
            <div class="property-detail-section">
                <h5 class="justify-content-start">
                    <i class="bi bi-exclamation-triangle"></i>
                    ¿Estás seguro que deseas eliminar este registro?
                </h5>

                <p class="text-muted mt-3">
                    Esta acción no se puede deshacer. Si hay propiedades asociadas a este elemento, es posible que el sistema no te permita eliminarlo.
                </p>

                <hr />

                <div class="mb-3">
                    <label class="text-muted small">Nombre</label>
                    <p class="fs-5 fw-bold mb-0">@Model.Name</p>
                </div>

                <div class="mb-3">
                    <label class="text-muted small">Descripción</label>
                    <p class="mb-0">@Model.Description</p>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn app-secondary-button">
                            <i class="bi bi-x-lg me-1"></i>Cancelar
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Sí, eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>