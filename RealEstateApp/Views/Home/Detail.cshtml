@model PropertyViewModel
@{
	ViewData["Title"] = $"Propiedad {Model.Code}";
}

<a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary mb-3"
   onclick="if (document.referrer.startsWith(location.origin)) { history.back(); return false; }">Volver</a>

<partial name="~/Views/Shared/Components/_PropertyDetailContent.cshtml" model="Model" />