<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - RealEstateApp</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>
	<header class="app-header">
		<nav class="navbar navbar-expand-lg app-navbar">
			<div class="container-fluid app-navbar-container">
				@{
					var homeController = User.IsInRole("Agente") ? "AgentHome"
						: User.IsInRole("Cliente") ? "ClientHome"
						: User.IsInRole("Administrador") ? "AdminHome"
						: "Home";
				}
				<a class="navbar-brand app-brand" asp-controller="@homeController" asp-action="Index">
					<i class="bi bi-house-door-fill"></i>
					<span>RealEstate<span class="app-brand-accent">App</span></span>
				</a>
				<button class="navbar-toggler app-navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="navbar-collapse collapse justify-content-between">
					<ul class="navbar-nav flex-grow-1 app-nav-links">
						@if (!User.Identity!.IsAuthenticated)
						{
							<li class="nav-item"><a class="nav-link app-nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
							<li class="nav-item"><a class="nav-link app-nav-link" asp-controller="Agents" asp-action="Index">Agentes</a></li>
							<li class="nav-item ms-auto"><a class="nav-link app-nav-link app-nav-link-auth app-nav-link-register" asp-controller="Account" asp-action="Register">Únete a la app</a></li>
							<li class="nav-item"><a class="nav-link app-nav-link app-nav-link-auth app-nav-link-login" asp-controller="Account" asp-action="Login">Iniciar sesión</a></li>
						}
						else if (User.IsInRole("Cliente"))
						{
							<li class="nav-item"><a class="nav-link app-nav-link" asp-controller="ClientHome" asp-action="Index">Home</a></li>
							<li class="nav-item"><a class="nav-link app-nav-link" asp-controller="Agents" asp-action="Index">Agentes</a></li>
							<li class="nav-item"><a class="nav-link app-nav-link" asp-controller="ClientHome" asp-action="MyProperties">Mis propiedades</a></li>
						}
						else if (User.IsInRole("Agente"))
						{
							<li class="nav-item"><a class="nav-link app-nav-link" asp-controller="AgentHome" asp-action="Index">Home del agente</a></li>
							<li class="nav-item"><a class="nav-link app-nav-link" asp-controller="AgentHome" asp-action="Profile">Mi perfil</a></li>
							<li class="nav-item"><a class="nav-link app-nav-link" asp-controller="AgentProperties" asp-action="Index">Mantenimiento de propiedades</a></li>
						}
						else if (User.IsInRole("Administrador"))
						{
							<li class="nav-item"><a class="nav-link app-nav-link" asp-controller="AdminHome" asp-action="Index">Dashboard</a></li>
							<li class="nav-item"><a class="nav-link app-nav-link" asp-controller="AdminAgents" asp-action="Index">Agentes</a></li>
							<li class="nav-item"><a class="nav-link app-nav-link" asp-controller="Administrator" asp-action="Index">Administradores</a></li>
							<li class="nav-item"><a class="nav-link app-nav-link" asp-controller="Developer" asp-action="Index">Desarrolladores</a></li>
							<li class="nav-item"><a class="nav-link app-nav-link" asp-controller="PropertyTypes" asp-action="Index">Tipos de Propiedad</a></li>
							<li class="nav-item"><a class="nav-link app-nav-link" asp-controller="SaleTypes" asp-action="Index">Tipos de Venta</a></li>
							<li class="nav-item"><a class="nav-link app-nav-link" asp-controller="Improvements" asp-action="Index">Mejoras</a></li>
						}
					</ul>
					@if (User.Identity.IsAuthenticated)
					{
						<form asp-controller="Account" asp-action="Logout" method="post" class="d-flex app-logout-form">
							<button type="submit" class="btn app-logout-button">
								<i class="bi bi-box-arrow-right"></i>
								Cerrar sesión
							</button>
						</form>
					}
				</div>
			</div>
		</nav>
	</header>
	<div class="container app-content-container">
		@if (TempData["Success"] != null)
		{
			<div class="alert alert-success alert-dismissible fade show">
				@TempData["Success"]
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			</div>
		}
		@if (TempData["Error"] != null)
		{
			<div class="alert alert-danger alert-dismissible fade show">
				@TempData["Error"]
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			</div>
		}
		<main role="main" class="pb-3 app-main">
			@RenderBody()
		</main>
	</div>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>