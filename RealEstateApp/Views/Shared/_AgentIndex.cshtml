@model IEnumerable<RealEstateApp.Core.Application.ViewModels.Staff.StaffUserListViewModel>
@{
    var title = ViewData["Title"] ?? "Agentes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@title</h2>
        <a asp-action="Create" class="btn btn-primary">Crear nuevo</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Correo</th>
                        <th class="text-center">Propiedades</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FirstName</td>
                            <td>@item.LastName</td>
                            <td>@item.Email</td>
                            <td class="text-center"><span class="badge bg-secondary">@item.PropertyCount</span></td>
                            <td class="text-center">
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                                    @(item.IsActive ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="text-end">
                                @if (!item.IsCurrentUser)
                                {
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                                    <a asp-action="ChangeStatus" asp-route-id="@item.Id"
                                       class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                        @(item.IsActive ? "Inactivar" : "Activar")
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">Mi usuario</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>