@model IEnumerable<RealEstateApp.Core.Application.ViewModels.Staff.StaffUserListViewModel>
@{
    var title = ViewData["Title"] ?? "Agentes";
}

<div class="property-detail-extra">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="app-section-title mb-0">@title</h1>
        <a asp-action="Create" class="btn app-btn-create">
            <i class="bi bi-plus-lg me-1"></i>Crear nuevo
        </a>
    </div>

    <div class="property-detail-section">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Correo</th>
                        <th>Propiedades</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.FirstName</td>
                            <td>@item.LastName</td>
                            <td>@item.Email</td>
                            <td class="text-center"><span class="badge bg-secondary">@item.PropertyCount</span></td>
                            <td class="text-center">
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                                    @(item.IsActive ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="text-end">
                                @if (!item.IsCurrentUser)
                                {
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn app-btn-delete">Eliminar</a>
                                    <a asp-action="ChangeStatus" asp-route-id="@item.Id" class="btn app-btn-delete">
                                        <i class="bi bi-power"></i> @(item.IsActive ? "Inactivar" : "Activar")
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">Mi usuario</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>