@model IEnumerable<RealEstateApp.Core.Application.ViewModels.Staff.StaffUserListViewModel>
@{
    var title = ViewData["Title"] ?? "Usuarios";
    var createAction = ViewData["CreateAction"] ?? "Create";
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@title</h2>
        <a asp-action="@createAction" class="btn btn-primary">Crear nuevo</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Usuario</th>
                        <th>Cédula</th>
                        <th>Correo</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FirstName</td>
                            <td>@item.LastName</td>
                            <td>@item.UserName</td>
                            <td>@(string.IsNullOrEmpty(item.Cedula) ? "N/A" : item.Cedula)</td>
                            <td>@item.Email</td>
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (!item.IsCurrentUser)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <a asp-action="ChangeStatus" asp-route-id="@item.Id" class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                        @(item.IsActive ? "Inactivar" : "Activar")
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">Mi usuario</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>