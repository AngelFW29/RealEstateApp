@model IEnumerable<RealEstateApp.Core.Application.ViewModels.Staff.StaffUserListViewModel>
@{
    var title = ViewData["Title"] ?? "Usuarios";
    var createAction = ViewData["CreateAction"] ?? "Create";
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
    var showPropertyCount = string.Equals(controllerName, "AdminAgents", StringComparison.OrdinalIgnoreCase);
}

<div class="property-detail-extra">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="app-section-title mb-0">@title</h1>
        <a asp-action="@createAction" class="btn app-btn-create">
            <i class="bi bi-plus-lg me-1"></i>Crear nuevo
        </a>
    </div>

    <div class="property-detail-section">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Usuario</th>
                        <th>Cédula</th>
                        <th>Correo</th>
                        @if (showPropertyCount)
                        {
                            <th class="text-center">Propiedades</th>
                        }
                        <th class="text-center">Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.FirstName</td>
                            <td>@item.LastName</td>
                            <td>@item.UserName</td>
                            <td>@(string.IsNullOrEmpty(item.Cedula) ? "N/A" : item.Cedula)</td>
                            <td>@item.Email</td>
                            @if (showPropertyCount)
                            {
                                <td class="text-center">
                                    <span class="badge bg-secondary">@item.PropertyCount</span>
                                </td>
                            }
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (!item.IsCurrentUser)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn app-btn-edit">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <a asp-action="ChangeStatus" asp-route-id="@item.Id" class="btn app-btn-delete">
                                        <i class="bi bi-power"></i> @(item.IsActive ? "Inactivar" : "Activar")
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">Mi usuario</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>