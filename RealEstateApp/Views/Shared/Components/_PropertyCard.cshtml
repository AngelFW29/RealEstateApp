@using System.Globalization
@model PropertyViewModel
@{
    var detailController = ViewData["DetailController"] as string ?? "Home";
}

<div class="card h-100 shadow-sm">
    @if (string.IsNullOrEmpty(Model.MainImagePath))
    {
        <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px;">
            Sin imagen
        </div>
    }
    else
    {
        <img src="@Model.MainImagePath" class="card-img-top" alt="Imagen de la propiedad @Model.Code" style="height: 200px; object-fit: cover;" />
    }

    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h5 class="card-title mb-0">@Model.PropertyTypeName</h5>
            @if (Model.Status == PropertyStatus.Sold)
            {
                <span class="badge bg-danger">Vendida</span>
            }
        </div>

        <p class="text-muted mb-1">Código: @Model.Code</p>
        <p class="mb-1">@Model.SaleTypeName</p>
        <p class="fw-bold fs-5 mb-2">RD$ @Model.Price.ToString("N2", CultureInfo.InvariantCulture)</p>

        <ul class="list-inline mb-0 text-muted">
            <li class="list-inline-item">@Model.Bedrooms hab.</li>
            <li class="list-inline-item">@Model.Bathrooms baños</li>
            <li class="list-inline-item">@Model.SizeInMeters.ToString("N2", CultureInfo.InvariantCulture) m²</li>
        </ul>
    </div>

    <div class="card-footer bg-transparent border-0">
        <a asp-controller="@detailController" asp-action="Detail" asp-route-id="@Model.Id" class="btn btn-primary w-100">Ver detalle</a>
    </div>
</div>