@model PropertyFilterViewModel
@{
    var controllerName = ViewData["FilterController"] as string ?? "Home";
    var actionName = ViewData["FilterAction"] as string ?? "Index";
    var routeId = ViewData["FilterRouteId"] as string;
    var propertyTypes = ViewData["PropertyTypes"] as IEnumerable<SelectListItem>;
}

<div class="card property-filter-card mb-4">
    <div class="card-body property-filter-body">
        <div class="property-filter-heading">
            <div>
                <span class="section-eyebrow">BÚSQUEDA</span>
                <h5 class="property-filter-title">Encuentra una propiedad</h5>
            </div>            
        </div>

        <form method="get" asp-controller="@controllerName" asp-action="@actionName" asp-route-id="@routeId" class="row g-2">
            <div class="col-md-9">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control app-form-control" placeholder="Introduce el código de la propiedad" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary app-primary-button w-100">
                    <i class="bi bi-search"></i> Buscar
                </button>
            </div>
        </form>

        <div class="property-filter-divider"></div>

        <div class="property-filter-subheading">
            <i class="bi bi-funnel"></i>
            <span>Filtrar</span>
        </div>

        <form method="get" asp-controller="@controllerName" asp-action="@actionName" asp-route-id="@routeId" class="row g-3">
            @if (propertyTypes is not null)
            {
                <div class="col-md-4">
                    <label asp-for="PropertyTypeId" class="form-label"></label>
                    <select asp-for="PropertyTypeId" asp-items="propertyTypes" class="form-select app-form-control">
                        <option value="">Todos</option>
                    </select>
                    <span asp-validation-for="PropertyTypeId" class="text-danger"></span>
                </div>
            }

            <div class="col-md-2">
                <label asp-for="MinPrice" class="form-label"></label>
                <input asp-for="MinPrice" type="number" step="0.01" min="0" class="form-control app-form-control" />
                <span asp-validation-for="MinPrice" class="text-danger"></span>
            </div>

            <div class="col-md-2">
                <label asp-for="MaxPrice" class="form-label"></label>
                <input asp-for="MaxPrice" type="number" step="0.01" min="0" class="form-control app-form-control" />
                <span asp-validation-for="MaxPrice" class="text-danger"></span>
            </div>

            <div class="col-md-2">
                <label asp-for="Bedrooms" class="form-label"></label>
                <input asp-for="Bedrooms" type="number" min="0" class="form-control app-form-control" />
                <span asp-validation-for="Bedrooms" class="text-danger"></span>
            </div>

            <div class="col-md-2">
                <label asp-for="Bathrooms" class="form-label"></label>
                <input asp-for="Bathrooms" type="number" min="0" class="form-control app-form-control" />
                <span asp-validation-for="Bathrooms" class="text-danger"></span>
            </div>

            <div class="col-12 d-flex flex-wrap gap-2 property-filter-actions">
                <button type="submit" class="btn btn-primary app-primary-button">
                    <i class="bi bi-funnel"></i> Filtrar
                </button>
                <a asp-controller="@controllerName" asp-action="@actionName" asp-route-id="@routeId" class="btn btn-outline-secondary app-secondary-button">
                    <i class="bi bi-arrow-counterclockwise"></i> Limpiar filtros
                </a>
            </div>
        </form>
    </div>
</div>